<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Vacancy_Requires_Unit</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 RecordType.DeveloperName = &quot;Vacancy&quot;,
 ISBLANK( Unit__c ) 
)</errorConditionFormula>
    <errorDisplayField>Unit__c</errorDisplayField>
    <errorMessage>Select the unit this vacancy campaign is for.</errorMessage>
</ValidationRule>
