<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Equity__c</fullName>
    <formula>BLANKVALUE( Current_Market_Value__c , Purchase_Price__c )- BLANKVALUE( Loan_Balance__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Market value (or purchase price if no estimate) minus loan balance</inlineHelpText>
    <label>Equity</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
