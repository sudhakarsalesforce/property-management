<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Install_Date_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula>InstallDate &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>InstallDate</errorDisplayField>
    <errorMessage>Install date can&apos;t be in the future.</errorMessage>
</ValidationRule>
