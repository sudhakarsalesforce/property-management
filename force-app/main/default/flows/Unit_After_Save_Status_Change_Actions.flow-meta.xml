<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Make_Ready_Tasks</name>
        <label>Build Make-Ready Tasks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTask.WhatId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue> {!$Record.Id}</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>TaskPrefix</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Subject</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Deep clean and inspect</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>DueInTwoDays</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTasks</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varTask</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>TaskPrefix</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Subject</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Complete repairs and paint touch-ups</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>DueInFiveDays</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTasks</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varTask</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>TaskPrefix</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Subject</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Take listing photos</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>DueInSevenDays</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTasks</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varTask</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>TaskPrefix</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Subject</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Review market rent before listing</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTasks</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varTask</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Make_Ready_Tasks</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Collect_Campaign_Id</name>
        <label>Collect Campaign Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varVacancyCampaignIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Vacancy_Campaigns.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Vacancy_Campaigns</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Show_Delete_Close_Channel_Campaigns</name>
        <label>Show Error Delete Channel Campaigns</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Unable to delete the Channel Campaign Details: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Show_Error_Delete_Vacancy_Campaign</name>
        <label>Show Error Delete Vacancy Campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Unable to delete the Vacancy Campaigns.Details: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Show_Status_Change_Error</name>
        <label>Show Status Change Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>The status change couldn&apos;t complete its follow-up actions, so it was not saved. Details: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Any_Active_Campaigns</name>
        <label>Any Active Campaigns?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Vacancy_Campaigns</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Vacancy_Campaigns</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_Changed</name>
        <label>What Changed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other Change</defaultConnectorLabel>
        <rules>
            <name>Vacancy_Ended</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Occupied</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Off Market</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Active_Vacancy_Campaigns</targetReference>
            </connector>
            <label>Vacancy Ended</label>
        </rules>
        <rules>
            <name>Moved_Out</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Vacant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Occupied</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Make_Ready_Tasks</targetReference>
            </connector>
            <label>Moved Out</label>
        </rules>
    </decisions>
    <description>When a unit&apos;s vacancy ends (Occupied or Off Market), closes its active campaigns. When a tenant moves out (Occupied to Vacant), creates make-ready tasks.</description>
    <environments>Default</environments>
    <formulas>
        <name>CampaignEndStatus</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Status__c}, &quot;Occupied&quot;), &quot;Completed&quot;, &quot;Aborted&quot;)</expression>
    </formulas>
    <formulas>
        <name>DueInFiveDays</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 5</expression>
    </formulas>
    <formulas>
        <name>DueInSevenDays</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+7</expression>
    </formulas>
    <formulas>
        <name>DueInTwoDays</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 2</expression>
    </formulas>
    <formulas>
        <name>TaskPrefix</name>
        <dataType>String</dataType>
        <expression>{!$Record.Property__r.Name} &amp; &quot; - &quot; &amp; {!$Record.Name} &amp; &quot;: &quot;</expression>
    </formulas>
    <interviewLabel>Unit - After Save - Status Change Actions {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Unit - After Save - Status Change Actions</label>
    <loops>
        <name>Loop_Vacancy_Campaigns</name>
        <label>Loop Vacancy Campaigns</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Active_Vacancy_Campaigns</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Collect_Campaign_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Close_Channel_Campaigns</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Make_Ready_Tasks</name>
        <label>Create Make-Ready Tasks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Show_Status_Change_Error</targetReference>
        </faultConnector>
        <inputReference>varTasks</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Active_Vacancy_Campaigns</name>
        <label>Get Active Vacancy Campaigns</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_Active_Campaigns</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Unit__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Campaign</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Close_Channel_Campaigns</name>
        <label>Close Channel Campaigns</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Close_Vacancy_Campaigns</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Show_Delete_Close_Channel_Campaigns</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>In</operator>
            <value>
                <elementReference>varVacancyCampaignIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>EndDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsActive</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>CampaignEndStatus</elementReference>
            </value>
        </inputAssignments>
        <object>Campaign</object>
    </recordUpdates>
    <recordUpdates>
        <name>Close_Vacancy_Campaigns</name>
        <label>Close Vacancy Campaigns</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Show_Error_Delete_Vacancy_Campaign</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>varVacancyCampaignIds</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>EndDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsActive</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>CampaignEndStatus</elementReference>
            </value>
        </inputAssignments>
        <object>Campaign</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>What_Changed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Unit__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varTask</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>varTasks</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>varVacancyCampaignIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
