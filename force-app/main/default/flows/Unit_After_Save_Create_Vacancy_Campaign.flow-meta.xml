    <description>When a Unit becomes Listed, creates a Vacancy campaign with one Listing Channel child per channel and rental member statuses. Skips if the Unit already has an active Vacancy campaign.</description>
    <environments>Default</environments>
    <formulas>
        <name>ChannelCampaignName</name>
        <dataType>String</dataType>
        <expression>{!VacancyCampaignName} &amp; &quot; - &quot; &amp; {!Loop_Channels}</expression>
    </formulas>
    <formulas>
        <name>VacancyCampaignName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Property__r.Name} &amp; &quot; - &quot; &amp; {!$Record.Name} &amp; &quot; - &quot; &amp;
CASE(MONTH({!$Flow.CurrentDate}),
  1, &quot;Jan&quot;, 2, &quot;Feb&quot;, 3, &quot;Mar&quot;, 4, &quot;Apr&quot;, 5, &quot;May&quot;, 6, &quot;Jun&quot;,
  7, &quot;Jul&quot;, 8, &quot;Aug&quot;, 9, &quot;Sep&quot;, 10, &quot;Oct&quot;, 11, &quot;Nov&quot;, &quot;Dec&quot;) &amp;
&quot; &quot; &amp; TEXT(YEAR({!$Flow.CurrentDate}))</expression>
    </formulas>
